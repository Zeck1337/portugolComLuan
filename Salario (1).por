programa {
  funcao inicio() {
    real salario
    real jornadaTrabalho 
    real salarioHora 

    escreva("quanto ganha por hora: \n")
    leia(salarioHora)

    escreva("Quantas horas trabalhadas: \n")
    leia(jornadaTrabalho)

    salario = jornadaTrabalho *  salarioHora

    escreva("Seu salario Total = \n",salario)
    
    
  }
}
